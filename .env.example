# Copy to .env in this repo, or to ~/.pi/agent/.env / ~/.pi/agent/project-flow.env for global Pi discovery.
# Used by scripts/link-global.mjs to create the global Pi symlink.
PI_PROJECT_FLOW_REPO="/absolute/path/to/Flow"

# Used by the Project Flow extension and /reload-flow to copy support files (theme, welcome art, docs) from this clone.
PI_PROJECT_FLOW_DEV_ROOT="/absolute/path/to/Flow"
