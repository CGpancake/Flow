# Copy to .env in this repo, or to ~/.pi/agent/.env / ~/.pi/agent/project-flow.env for global Pi discovery.
# Used by scripts/link-global.mjs to create the global Pi symlink.
PI_PROJECT_FLOW_REPO="/absolute/path/to/Flow"

# Used by the Project Flow extension and /reload-flow to copy support files (theme, welcome art, docs) from this clone.
PI_PROJECT_FLOW_DEV_ROOT="/absolute/path/to/Flow"

# Optional model/thinking routing for Project Flow subagents.
# Model values may include provider/model ids, or pi model shorthand such as sonnet:medium.
PI_PROJECT_FLOW_CHEAP_MODEL=""
PI_PROJECT_FLOW_WORKER_MODEL=""
PI_PROJECT_FLOW_EXPENSIVE_MODEL=""
PI_PROJECT_FLOW_REVIEW_MODEL=""

# Optional explicit thinking level for GSD worker/reviewer chains. Valid pi levels include off, minimal, low, medium, high, xhigh.
# Scout keeps its agent default unless PI_PROJECT_FLOW_GSD_SCOUT_THINKING is set.
PI_PROJECT_FLOW_GSD_THINKING="medium"
PI_PROJECT_FLOW_GSD_SCOUT_MODEL=""
PI_PROJECT_FLOW_GSD_SCOUT_THINKING=""
PI_PROJECT_FLOW_GSD_WORKER_THINKING=""
PI_PROJECT_FLOW_GSD_REVIEW_THINKING=""
